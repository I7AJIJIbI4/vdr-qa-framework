{
  "name": "vdr-qa-framework",
  "version": "1.0.0",
  "description": "QA automation for the Virtual Data Room MVP",
  "scripts": {
    "test": "playwright test --project=unit --project=api && playwright test --project=e2e",
    "test:unit": "playwright test --project=unit",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:security": "playwright test --grep @security",
    "typecheck": "tsc",
    "report": "playwright show-report"
  },
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.5",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3"
  },
  "private": true
}
